{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "0",
        "model": {
          "type": "minecraft:model",
          "model": "bountiful:item/bounty-common"
        }
      },
      {
        "when": "1",
        "model": {
          "type": "minecraft:model",
          "model": "bountiful:item/bounty-uncommon"
        }
      },
      {
        "when": "2",
        "model": {
          "type": "minecraft:model",
          "model": "bountiful:item/bounty-rare"
        }
      },
      {
        "when": "3",
        "model": {
          "type": "minecraft:model",
          "model": "bountiful:item/bounty-epic"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "bountiful:item/bounty-common"
    }
  }
}
